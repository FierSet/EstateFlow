<div class="dashboard-content">

    <header class="topbar">
        <h1>Dashboard</h1>
        
    </header>
    <div class="dashboard-list">
        
        <section id="properties-section" class="stats-grid">
            <h1 id="dashboard-properties" onclick="loadpartialbyinteface('My-Properties')">
                properties
            </h1>
            <div class="dashboar-base">
                <i class="fa-solid fa-house"></i>
                <div id="propertylist-dashboar">
                    @foreach(Propertycount prop in Model.Propertiescount ?? Enumerable.Empty<Propertycount>())
                    {
                        <span>
                            <span id="optionroomtype-@prop.PropertyTypeID"></span>
                            <span id="totalptoprty">: @prop.TOTAL</span>
                        </span>
                    }
                </div>
            </div>

        </section>

        <section id="properties-nextpay" class="stats-grid">
            <h1 id="dashboard-nextpay" onclick="loadpartialbyinteface('Payments')">
                payment
            </h1>
            <div class="dashboar-base">
                <i class="fa-solid fa-clipboard"></i>
                <h5>next payment</h5>
            </div>
        </section>

        <section id="properties-nextpay" class="stats-grid">
            <h1 id="dashboard-nextpay" onclick="loadpartialbyinteface('Maintenance')">
                Maintanment request
            </h1>
            <div class="dashboar-base">
                <i class="fa-solid fa-wrench"></i>
                <h5>Pending request</h5>
            </div>
        </section>

    </div>

</div>