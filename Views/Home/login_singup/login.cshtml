<div class="login-wrap" id="loginform">
	
	<div class="login-html">

		<input id="tab-1" type="radio" name="tab" class="sign-in"  checked><label for="tab-1" class="tab" id="sign-in-label"></label>
		<input id="tab-2" type="radio" name="tab" class="sign-up"><label for="tab-2" class="tab" id="sign-up-label"></label>

		<div class="login-form">

			<form class="sign-in-htm" onsubmit="signin('Email', 'Password', 'error-signin'); return false;">
				<div id = "error-signin" class="group"></div>
				<div class="group">
					<label for="user" class="label" id="username-login"></label>
					<input id="Email" type="text" class="input" placeholder="example@email.com" required />
				</div>
				<div class="group">
					<label for="pass" class="label" id="password-login"></label>
					<div class="password-container">
						<input id="Password" type="password" class="input" data-type="password" required >  
						<button type="button" id="buttonpass" class="show-password-btn" onclick="togglePassword('Password', 'buttonpass', 'eyeIcon')"> <i id="eyeIcon" class="fa-solid fa-eye"></i> </button> 
					</div>
				</div>
				<div class="group">
					<input id="check" type="checkbox" class="check" checked>
					<label for="check" ><span class="icon"></span> <span id="keep-signed-in"></span></label>
				</div>
				<div class="group">
					<input type="submit" class="button" id="sign-in-button" value="" />
				</div>
				<div class="hr"></div>
				<div class="foot-lnk">
					<a href="#forgot" id="forgot-password-link"></a>
				</div>
			</form>
            
			<form class="sign-up-htm" onsubmit="signup('Email2', 'Password1', 'Password2', 'error-signup'); return false;">
				<div id = "error-signup" class="group"></div>
				<div class="group">
					<label class="label" id="username-signup"></label>
					<input id="Email2" type="text" class="input" placeholder="example@email.com" required/>
				</div>
				<div class="group">
					<label class="label" id="password-signup"></label>
					<div class="password-container">
						<input id="Password1" type="password" class="input" data-type="password" required/> 
						<button type="button" id="buttonpass1" class="show-password-btn" onclick="togglePassword('Password1', 'buttonpass1', 'eyeIcon1')"> <i id="eyeIcon1" class="fa-solid fa-eye"></i>  </button> 
					</div>
				</div>
				<div class="group">
					<label class="label" id="repeat-password-signup"></label>
					<div class="password-container"> 
						<input id="Password2" type="password" class="input" data-type="password" required>
						<button type="button" id="buttonpass2" class="show-password-btn" onclick="togglePassword('Password2', 'buttonpass2', 'eyeIcon2')"> <i id="eyeIcon2" class="fa-solid fa-eye"></i> </button> 
					</div>
				</div>

				<div class="group">
					<input type="submit" class="button" id="sign-up-button" value="">
				</div>
				<div class="hr"></div>
				<div class="foot-lnk">
					<label for="tab-1" id="already-member-label"></label>
				</div>
			</form>

		</div>

	</div>

</div>
